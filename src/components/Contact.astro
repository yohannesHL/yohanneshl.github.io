---
const callUrl = 'https://calendly.com/yohannes-7/15min';
---

<section class="col-xs-12">
  <div class="container content-column">
    <h2>Lets talk</h2>
    <hr class="animation__line animation--delay-2" />
    <div class="flex-column flex--align-center">
      <div class="flex--grow">
        <div class="social">
          <ul id="contact" class="social__list">
            <li>
              <a class="btn animation__pulse--hover" href={callUrl}>
                <span>Book a call</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
