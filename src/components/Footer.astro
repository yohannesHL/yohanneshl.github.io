---
const year = new Date().getFullYear();
const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/yohanneslibanos' },
  { label: 'GitHub', href: 'https://github.com/yohanneshl' },
  { label: 'Email', href: 'mailto:yohannes@fluxsoft.dev' },
];
---

<footer class="site-footer">
  <div class="container mx-auto px-4 content-column site-footer__inner">
    <div class="site-footer__top">
      <a class="site-footer__mark" href="/" aria-label="Yohannes Libanos — home">Y·L</a>
      <nav aria-label="Social and contact links">
        <ul class="site-footer__links">
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="site-footer__meta">
      <p>© {year} Yohannes Libanos. Independent full-stack and AI contractor.</p>
      <small>All client logos, screenshots and trademarks belong to their respective owners.</small>
    </div>
  </div>
</footer>
