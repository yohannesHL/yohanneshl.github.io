---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section id="work" class="projects" aria-labelledby="work-title">
  <div class="container mx-auto px-4 content-column">
    <div class="projects__pin" data-project-pin>
      <header class="projects__header">
        <h2 id="work-title">Featured work</h2>
      </header>

      <div class="projects__stage" data-project-stage>
        <div class="projects__list" data-project-stack>
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/project-stack';
</script>
